{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tourney",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // The Express API, unchanged, running in the Dockerfile at the repo root.
  // Bound to a Durable Object so Cloudflare can address one container
  // instance per class, per Containers' current design.
  "containers": [
    {
      "class_name": "TourneyContainer",
      "image": "./Dockerfile",
      // A ceiling, not a reservation. Containers bill per running second, so
      // raising this costs nothing on its own — instances only start when
      // there is traffic to justify them, and stop again when there is not.
      //
      // It was 1, which meant every request in the world queued behind a
      // single process. Measured against production before this change:
      // 50 concurrent requests to /api/tournaments all returned 200, but p50
      // was 4.4s and p95 6.5s, against 463ms for the same request on its own.
      // Fifty people opening the browse page as a tournament starts is a
      // normal evening for this product, not a stress test.
      "max_instances": 5,
      "instance_type": "basic",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "TOURNEY_CONTAINER", "class_name": "TourneyContainer" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TourneyContainer"] }],

  // The built SPA. /api/* runs the Worker (and therefore the container)
  // first; everything else falls back to the static file, then index.html.
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },

  // Replaces the Vercel cron that hit /api/cron/reseed at 04:00 UTC daily.
  // Container stdout/stderr and Worker logs. Without this a crash inside the
  // container is invisible — the only signal is a generic "container is not
  // running" at the edge.
  "observability": { "enabled": true },

  "triggers": {
    // Daily at 04:00 UTC rebuilds the demo data. Hourly drives the
    // notification sweep — a "your match starts within the hour" reminder
    // cannot be delivered by a job that runs once a day. `worker/index.js`
    // tells them apart by the cron string.
    "crons": ["0 4 * * *", "0 * * * *"],
  },
}
