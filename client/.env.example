# Client environment — copy to .env.development / .env.production as needed.
# Only VITE_-prefixed variables reach the browser bundle. Never put secrets here.
# Placeholder only; Phase 1 of PLAN.md replaces this with the final variable set.

# Base URL of the API. Leave empty to use the same-origin /api path.
VITE_BACKEND_URL=http://localhost:2000

# Public URL of this client (used for invite links)
VITE_FRONTEND_URL=http://localhost:5173
