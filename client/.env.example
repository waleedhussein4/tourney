# Client environment
#
# Copy this file to client/.env.local and adjust if needed — the defaults below
# work for local development as-is.
#
# Only VITE_-prefixed variables reach the browser. Everything here ships inside
# the JavaScript bundle and is public: never put a secret in this file.

# Base URL of the API. Leave EMPTY so the client calls a same-origin, relative
# `/api` path: in development Vite proxies that to http://localhost:2000, and in
# production the client and API share an origin on Vercel. Set it to an absolute
# URL only when pointing the client at an API on a different host.
VITE_API_URL=

# Legacy alias read by the pre-Phase-4 client code. Leave EMPTY for the same
# reason as above — an unset value would produce "undefined/api/..." request
# URLs. Phase 4 of PLAN.md removes this in favour of VITE_API_URL.
VITE_BACKEND_URL=

# Public URL of this client, used to build team invite links.
VITE_FRONTEND_URL=http://localhost:5173
