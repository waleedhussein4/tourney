{
  "name": "tourney",
  "version": "2.0.0",
  "private": true,
  "description": "Tournament hosting platform — brackets & battle royale, teams, credits economy. MERN monorepo.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev -w server\" \"npm:dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build -w client && node scripts/prerender-policies.mjs",
    "start": "npm run start -w server",
    "lint": "npm run lint -w server && npm run lint -w client",
    "lint:fix": "npm run lint:fix -w server && npm run lint:fix -w client",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test -w server",
    "check:regressions": "bash scripts/check-regressions.sh",
    "seed": "npm run seed -w server",
    "backup": "npm run backup -w server",
    "restore": "npm run restore -w server",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "wrangler": "^4.28.1"
  }
}
