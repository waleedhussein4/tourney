#!/bin/sh
# Same rule as commit-msg, applied to every commit being pushed, so a message
# written with --no-verify still cannot reach the remote.

if git log origin/main..HEAD --format=%B | grep -qiE '^(co-authored-by:|generated with)'; then
  echo "Rejected: a commit message has a Co-authored-by trailer or a Generated with footer." >&2
  exit 1
fi

exit 0
