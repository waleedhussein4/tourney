#!/bin/sh
# Commit messages follow Conventional Commits, as described in CONTRIBUTING.md.
# The subject is checked here so a malformed message is caught before it lands
# rather than at review time.

subject=$(head -n 1 "$1")

# Merge, revert and fixup commits are generated by git itself.
case "$subject" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

if ! printf '%s' "$subject" |
  grep -qE '^(feat|fix|chore|docs|test|refactor|perf|ci|build|style)(\([a-z0-9-]+\))?!?: .+'; then
  echo "Rejected: subject must be a Conventional Commit, e.g. \"fix: correct the bracket seeding\"." >&2
  echo "Got: $subject" >&2
  exit 1
fi

if [ ${#subject} -gt 72 ]; then
  echo "Rejected: subject is ${#subject} characters; keep it to 72." >&2
  exit 1
fi
