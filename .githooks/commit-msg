#!/bin/sh
# Commit messages are written by the person making the commit. This project has
# no co-authored commits, so any co-author trailer and any generated-by footer
# is rejected outright.

if grep -qiE '^(co-authored-by:|generated with)' "$1"; then
  echo "Rejected: commit message has a Co-authored-by trailer or a Generated with footer." >&2
  exit 1
fi
