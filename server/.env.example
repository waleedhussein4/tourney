# Server environment — copy to .env and fill in. Never commit the real file.
# Placeholder only; Phase 1 of PLAN.md replaces this with validated config.

# MongoDB connection string (Atlas M0 or a local mongod)
DATABASE_URL=mongodb://127.0.0.1:27017/tourney

# Secret used to sign auth JWTs. Generate a fresh random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=

# development | production
NODE_ENV=development

# Port the API listens on locally
PORT=2000

# Origin of the client, used for CORS in the legacy server
FRONTEND_URL=http://localhost:5173
