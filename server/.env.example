# Server environment
#
# Copy this file to server/.env and fill in the values. Never commit the real
# file — .env and .env.* are gitignored (this example is the one exception).
#
# Everything here is read, validated, and normalised once by
# server/src/config/env.js. A missing or malformed required value stops the
# server at boot with a message naming the variable, instead of surfacing as a
# mysterious undefined later on.

# --- Required -----------------------------------------------------------------

# MongoDB connection string. Local mongod, or an Atlas M0 cluster:
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tourney
# Legacy alias, still accepted: DATABASE_URL
MONGODB_URI=mongodb://127.0.0.1:27017/tourney

# Secret used to sign auth JWTs. Must be at least 32 characters in production.
# Generate a fresh one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Legacy alias, still accepted: SECRET
JWT_SECRET=

# --- Optional -----------------------------------------------------------------

# development | production | test. Defaults to development.
NODE_ENV=development

# Port the API listens on. Defaults to 2000, which is what the Vite dev proxy
# in client/vite.config.js targets.
PORT=2000

# Origin of the client, for CORS. Leave unset in the target setup: locally Vite
# proxies /api to this server, and in production the client and API are
# same-origin on Vercel — so there is no cross-origin request to allow.
# Legacy alias, still accepted: FRONTEND_URL
CLIENT_URL=
