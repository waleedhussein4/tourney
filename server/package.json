    "morgan": "^1.10.0",
    "sanitize-html": ">=2.13.0 <2.17.6",
    "uuid": "^9.0.1",
    "validator": "^13.11.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
